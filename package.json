{
  "name": "blog-frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "lint": "next lint",
    "audit": "node e2e/audit.mjs",
    "spec-audit": "node e2e/spec-audit.mjs",
    "regression": "node e2e/regression.mjs",
    "test:all": "node e2e/spec-audit.mjs && node e2e/regression.mjs",
    "backend:dev": "npm --prefix \"${BACKEND_DIR:-/home/nuruddin-kawsar/Documents/r2sdet/blog-api}\" run dev",
    "backend:start": "npm --prefix \"${BACKEND_DIR:-/home/nuruddin-kawsar/Documents/r2sdet/blog-api}\" start",
    "kill:frontend": "fuser -k 3001/tcp 2>/dev/null || true",
    "kill:backend": "fuser -k 3000/tcp 2>/dev/null || true",
    "restart:frontend": "npm run kill:frontend && npm run dev",
    "restart:backend": "npm run kill:backend && npm run backend:dev",
    "restart": "npm run kill:frontend && npm run kill:backend && (npm run backend:dev &) && npm run dev"
  },
  "dependencies": {
    "next": "14.2.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.15",
    "playwright": "1.63.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14"
  }
}